# Maintainer: iMacnucintosh
# Builds Seeker from the git repository (a -git package: pkgver follows the commits).
#   cd packaging && makepkg -si
pkgname=seeker-git
pkgver=r0.0000000
pkgrel=1
pkgdesc="Material You file manager for the Sylphrena shell"
arch=('x86_64')
url="https://github.com/iMacnucintosh/seeker"
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'glib2' 'file' 'zip')
makedepends=('git')
optdepends=('pipewire: sounds of the sound theme'
            'sound-theme-freedesktop: the sounds themselves'
            'gvfs: trash and mounts of other devices')
# /usr/bin/seeker would clash with the other `seeker` of the AUR (a disk benchmark)
conflicts=('seeker')
source=("git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd seeker
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd seeker
  qmake6 PREFIX=/usr
  make
}

package() {
  cd seeker
  make INSTALL_ROOT="$pkgdir" install
  # The launcher entries (and Seeker's D-Bus service) start the user-local build in ~/.local/bin; a package lives in /usr/bin
  find "$pkgdir/usr/share" \( -name '*.desktop' -o -name '*.service' \) -exec sed -i -E \
    -e "s#/bin/sh -c 'exec \"\\\$HOME/\\.local/bin/seeker\" \"\\\$@\"' sh#/usr/bin/seeker#" \
    -e "s#/bin/sh -c 'exec \"\\\$HOME/\\.local/bin/seeker\"([^']*)'#/usr/bin/seeker\\1#" {} +
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
